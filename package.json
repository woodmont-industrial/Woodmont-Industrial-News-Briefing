{
  "name": "woodmont-rss-feed",
  "version": "1.12.26",
  "description": "RSS feed aggregator for Woodmont Industrial Partners",
  "main": "rssfeed.ts",
  "scripts": {
    "start": "npx tsx rssfeed.ts",
    "build": "npx tsx rssfeed.ts --build-static",
    "build-static": "npx tsx rssfeed.ts --build-static",
    "build-reserve-pool": "npx tsx src/build/build-reserve-pool.ts",
    "dev": "npx tsx rssfeed.ts",
    "municipal:shadow": "node --import tsx scripts/municipal-shadow.ts",
    "municipal:fixture": "node --import tsx scripts/municipal-shadow.ts --fixture",
    "test:municipal": "node --import tsx src/municipal/municipal.test.ts",
    "test:newsletter-diagnostics": "npx tsx src/server/newsletter-diagnostics.test.ts",
    "typecheck": "tsc -p tsconfig.municipal.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.11",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
