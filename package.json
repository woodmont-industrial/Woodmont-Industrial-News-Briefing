{
  "name": "woodmont-rss-feed",
  "version": "1.12.26",
  "description": "RSS feed aggregator for Woodmont Industrial Partners",
  "main": "rssfeed.ts",
  "scripts": {
    "start": "npx tsx rssfeed.ts",
    "build": "npx tsx rssfeed.ts --build-static",
    "build-static": "npx tsx rssfeed.ts --build-static",
    "build:capital-markets-shadow": "node --import tsx rssfeed.ts --build-capital-markets-shadow",
    "send:capital-markets-canary": "node --import tsx rssfeed.ts --send-capital-markets-canary",
    "build:cm-watchlist": "python3 scripts/build-capital-markets-watchlist.py",
    "encode:cm-watchlist": "node scripts/encode-capital-markets-watchlist.mjs",
    "validate:cm-watchlist-privacy": "node scripts/validate-capital-markets-privacy.mjs",
    "build-reserve-pool": "npx tsx src/build/build-reserve-pool.ts",
    "dev": "npx tsx rssfeed.ts",
    "test:newsletter-diagnostics": "npx tsx src/server/newsletter-diagnostics.test.ts",
    "test:capital-markets": "node tests/capital-markets/run-all.mjs && node --import tsx src/server/capital-markets-delivery.test.ts && node --import tsx src/server/capital-markets-competitor-sources.test.ts"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.11",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.7.0"
  }
}
